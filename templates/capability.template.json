      { "step": 1, "by": "menu", "text": "左侧菜单项文字" },
      { "step": 2, "by": "label", "text": "字段标签", "action": "type" },
      { "step": 3, "by": "button", "text": "按钮文字", "action": "click" }
    ],
    "waits": [ { "after": 3, "for": "结果表出现/提示条文字" } ]
  },

  "automationBoundary": {
    "needsHuman": ["登录验证码", "短信确认"],
