  },

  "steps": [
    { "n": 1, "do": "语义定位 + 动作", "expect": "可观察的反馈（不要写『成功』）" }
  ],

  "verify": [
    { "name": "columns_present", "path": "artifacts/records/x.csv", "columns": ["id"] }
  ],

  "effectsDetail": {
    "changes": "会不会改业务状态",
    "outbound": "会不会对外发送",
    "idempotent": "重复执行会怎样"
  },

  "evidence": { "frames": "f018-f024", "assets": ["assets/xxx.jpg"] },

  "unknowns": ["界面上看到但没操作过的分支"],

  "updatedAt": "YYYY-MM-DD",
  "learnedBy": "learn-skill"
