  "inputs": [
    { "name": "scope", "type": "list", "required": true,
      "desc": "入参含义 + 从哪来（用户给 / 上游步骤产物）" }
  ],

  "outputs": [
    { "name": "records", "path": "artifacts/records/*.csv", "type": "csv",
      "desc": "产物落在 run 目录内的相对路径（引擎靠它回读证据）" }
  ],

  "secretsRef": ["ref:账号来源"],

  "selectors": {
    "page": "页面标题或 URL 特征（判断前置条件是否满足）",
